<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F4F6">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Control de Sincronización"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:layout_marginBottom="24dp" />

        <!-- Interruptor Maestro -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sw_monitoring"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Monitoreo en tiempo real"
            android:textSize="16sp"
            android:checked="true"
            android:padding="12dp"
            android:background="@android:color/white" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp"
            android:textColor="#6B7280"
            android:text="Cargando estado..." />

        <!-- Token Editable -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Token de Vinculación:"
            android:textStyle="bold"
            android:layout_marginTop="32dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_token_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Token"
                android:inputType="textNoSuggestions"
                android:fontFamily="monospace" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btn_save_token"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?attr/borderlessButtonStyle"
            android:text="GUARDAR TOKEN"
            android:textColor="#4F46E5"
            android:layout_gravity="end" />

        <!-- Pruebas y Seguridad -->
        <Button
            android:id="@+id/btn_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="ENVIAR SEÑAL DE PRUEBA"
            android:backgroundTint="#4F46E5" />

        <Button
            android:id="@+id/btn_admin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="CONFIGURAR ANTI-BORRADO"
            android:backgroundTint="#EF4444" />

        <Button
            android:id="@+id/btn_disable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="PERMISOS DE SISTEMA (AVANZADO)"
            style="?attr/materialButtonOutlinedStyle" />

    </LinearLayout>
</ScrollView>
